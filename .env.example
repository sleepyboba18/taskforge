APP_NAME=TaskForge
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=5000

DATABASE_URL=postgresql+psycopg://username:password@host:5432/database

SECRET_KEY=change-me
WORKER_COUNT=2
WORKER_POLL_INTERVAL=1.0
WORKER_SHUTDOWN_TIMEOUT=30
RETRY_BASE_DELAY=5
RETRY_MAX_DELAY=3600
RETRY_POLL_INTERVAL=1.0
RETRY_BATCH_SIZE=100
SCHEDULER_POLL_INTERVAL=1.0
SCHEDULER_BATCH_SIZE=100
MISFIRE_POLICY=SKIP
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=1000
METRICS_DEFAULT_WINDOW=24h
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN=300
RATE_LIMIT_OPERATOR=120
RATE_LIMIT_VIEWER=60
RATE_LIMIT_RETENTION_SECONDS=3600
RATE_LIMIT_FAIL_OPEN=false
WORKER_HEARTBEAT_INTERVAL=5
WORKER_STALE_TIMEOUT=30
RECOVERY_POLL_INTERVAL=10
CORS_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=False
